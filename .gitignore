# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/

# Test and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environment and secrets (only .env.example is tracked as the public template)
.env*
!.env.example


# IDE and editor (track shared agent config under .cursor/rules and .cursor/skills)
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**
.vscode/
.idea/
*.swp
*.swo

# Local agent tooling (track project skills under .agents/skills)
.agents/*
!.agents/skills/
!.agents/skills/**
skills-lock.json

# OS
.DS_Store
Thumbs.db

# Next.js
node_modules/
.next/
out/

# Playwright
/web/test-results/
/web/playwright-report/
/web/blob-report/
